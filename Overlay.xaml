<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:rans0m"
        xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif" x:Class="rans0m.Overlay"
        mc:Ignorable="d"
        Title="RANS0M" ShowInTaskbar="False" IsTabStop="False" Topmost="True" ResizeMode="NoResize"
        WindowState="Maximized"
        WindowStyle="None"
        Background="Transparent" Loaded="Window_Loaded" AllowsTransparency="True"
>

    <Grid x:Name="grid">
        <Grid.RowDefinitions>
            <RowDefinition Height="0*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Image x:Name="staticBg" Stretch="Fill" Grid.Row="1" gif:AnimationBehavior.SourceUri="/Assets/static.gif" gif:AnimationBehavior.AutoStart="True" Opacity="0.1"/>
        <Image x:Name="img_idle" Height="192" Width="192" Source="/Assets/ransom_idle.png" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="1"/>

        <Image x:Name="img_stopsign" Height="192" HorizontalAlignment="Center" VerticalAlignment="Center" Width="192" Source="/Assets/stop_sign.png" Grid.Row="1" Panel.ZIndex="1"/>
        <Image x:Name="img_attack" HorizontalAlignment="Left" Height="900" VerticalAlignment="Top" Width="900" Source="/Assets/ransom_attack.png" Grid.Row="1" Panel.ZIndex="1" gif:AnimationBehavior.SourceUri="/Assets/ransom_attack.gif"/>
        <Image x:Name="redVignette" Grid.Row="1" Panel.ZIndex="1" Stretch="Fill" gif:AnimationBehavior.SourceUri="/Assets/red_vignette.gif"/>

        <Viewbox x:Name="vb_download" Width="668" Height="88" Panel.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.RowSpan="2" Stretch="Uniform" StretchDirection="Both">
            <Grid Width="668" Height="88">
                <Label x:Name="txt_download" Content="DOWNLOADING" HorizontalAlignment="Center" Foreground="White" FontSize="36" FontFamily="Consolas" Background="{x:Null}" Panel.ZIndex="1" VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontWeight="Normal"/>
                <Border x:Name="downloadProgressBar" BorderBrush="#000000" BorderThickness="3" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="669" Height="42">
                    <Border BorderBrush="#cc0000" BorderThickness="2">
                        <Grid Background="#0a0000">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#cc0000" BorderBrush="#000000" BorderThickness="1,1,1,1" x:Name="Seg0" Margin="0,0,65,0" Grid.ColumnSpan="2"/>
                            <Border Grid.Column="1" Background="#cc0000" BorderBrush="#000000" BorderThickness="1,1,1,1" x:Name="Seg1" Margin="0,0,65,0" Grid.ColumnSpan="2"/>
                            <Border Grid.Column="2" Background="#cc0000" BorderBrush="#000000" BorderThickness="1,1,1,1" x:Name="Seg2" Margin="0,0,65,0" Grid.ColumnSpan="2"/>
                            <Border Grid.Column="3" Background="#cc0000" BorderBrush="#000000" BorderThickness="1,1,1,1" x:Name="Seg3" Margin="0,0,65,0" Grid.ColumnSpan="2"/>
                            <Border Grid.Column="4" Background="#cc0000" BorderBrush="#000000" BorderThickness="1,1,1,1" x:Name="Seg4" Margin="0,0,65,0" Grid.ColumnSpan="2"/>
                            <Border Grid.Column="5" Background="Black" BorderBrush="#000000" BorderThickness="1,1,1,1" x:Name="Seg5" Margin="0,0,65,0" Grid.ColumnSpan="2"/>
                            <Border Grid.Column="6" Background="Black" BorderBrush="#000000" BorderThickness="1,1,1,1" x:Name="Seg6" Margin="0,0,65,0" Grid.ColumnSpan="2"/>
                            <Border Grid.Column="7" Background="Black" BorderBrush="#000000" BorderThickness="1,1,1,1" x:Name="Seg7" Margin="0,0,65,0" Grid.ColumnSpan="2"/>
                            <Border Grid.Column="8" Background="Black" BorderBrush="#000000" BorderThickness="1,1,1,1" x:Name="Seg8" Margin="0,0,65,0" Grid.ColumnSpan="2"/>
                            <Border Grid.Column="9" Background="Black" BorderBrush="#000000" BorderThickness="1,1,1,1" x:Name="Seg9" Margin="0,0,65,0" Grid.ColumnSpan="2"/>
                        </Grid>
                    </Border>
                </Border>
            </Grid>
        </Viewbox>

    </Grid>
</Window>
